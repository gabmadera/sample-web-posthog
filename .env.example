# Copy to .env.local for local dev. All keys are NEXT_PUBLIC_* (inlined into the
# client bundle at build time); a missing key disables that SDK's provider.
# The GitHub Pages build reads the same names from repo Actions variables.

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_UXCAM_KEY=
NEXT_PUBLIC_LOGROCKET_APP_ID=
